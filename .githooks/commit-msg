#!/bin/sh
# Rejects commit messages that do not follow Conventional Commits.
# Enable once per clone: git config core.hooksPath .githooks

message_file="$1"
header=$(grep -v '^#' "$message_file" | sed '/^[[:space:]]*$/d' | head -n 1)

# Allow messages generated by git itself.
case "$header" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

types='feat|fix|test|docs|refactor|chore'
pattern="^($types)(\([a-z0-9-]+\))?!?: [^ ].*$"

if ! printf '%s\n' "$header" | grep -Eq "$pattern"; then
  echo "commit-msg: header must follow Conventional Commits: <type>(<scope>)?: <subject>" >&2
  echo "commit-msg: allowed types: $(echo "$types" | tr '|' ' ')" >&2
  echo "commit-msg: got: $header" >&2
  exit 1
fi

if [ "${#header}" -gt 72 ]; then
  echo "commit-msg: header must be at most 72 characters (got ${#header})" >&2
  exit 1
fi
